# Copy this file to .env and fill in real values. Never commit .env!

# PostgreSQL (used by the docker-compose "db" service)
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind

# Backend database connection (port 5433 = the Docker database on your computer)
DATABASE_URL=postgresql+psycopg://documind:change-me@localhost:5433/documind

# Secret used to sign login tokens. Make a random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
# How long a login token stays valid (minutes)
JWT_EXPIRE_MINUTES=60

# Which AI answers questions, summarizes and extracts:
#   gemini = Google Gemini, free tier (key from https://aistudio.google.com/apikey)
#   claude = Anthropic Claude, paid (key from https://console.anthropic.com)
LLM_PROVIDER=gemini
# The API key for that provider
LLM_API_KEY=
# Model to use. Leave empty for the provider's default
# (gemini-3.5-flash-lite for Gemini, claude-opus-5-5 for Claude)
LLM_MODEL=

# PDF uploads: folder to save them in, and the size limit
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
# Longest PDF accepted (pages). Raise it if your server has more CPU.
MAX_PDF_PAGES=30

# Frontend address(es) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3000

# Port the backend uses on your computer (change it if 8000 is already in use)
BACKEND_PORT=8000
