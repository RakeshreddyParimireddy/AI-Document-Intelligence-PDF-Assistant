# Copy this file to .env and fill in real values. Never commit .env!

# PostgreSQL (used by the docker-compose "db" service)
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind

# Backend database connection (port 5433 = the Docker database on your computer)
DATABASE_URL=postgresql+psycopg://documind:change-me@localhost:5433/documind

# Secret used to sign login tokens. Make a random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
# How long a login token stays valid (minutes)
JWT_EXPIRE_MINUTES=60

# Claude API key from https://console.anthropic.com (starts with sk-ant-)
LLM_API_KEY=
# Which Claude model answers questions
LLM_MODEL=claude-opus-5-5

# PDF uploads: folder to save them in, and the size limit
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Port the backend uses on your computer (change it if 8000 is already in use)
BACKEND_PORT=8000
